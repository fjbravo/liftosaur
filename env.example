# Liftosaur self-hosted configuration. Copy to .env and fill in:
#
#   cp env.example .env
#
# docker compose reads .env from the repo root automatically. Variables exported in your
# shell take precedence over this file - watch out for AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, which here are MinIO's root credentials, not real AWS ones.

# ---------------------------------------------------------------- public URL

# Public base URL of this deployment, including the scheme and any non-default port.
# It is baked into the images at build time (server-rendered pages and the web bundle
# resolve API hosts from it), so after changing it re-run `docker compose up -d --build`.
HOST=http://localhost

# Host port the web (nginx) container publishes. Keep HOST in sync when it is not 80,
# e.g. HTTP_PORT=8080 with HOST=http://localhost:8080.
HTTP_PORT=80

# ---------------------------------------------------------------- secrets

# Generate each of these with: openssl rand -hex 32
# Changing LIFTOSAUR_COOKIE_SECRET invalidates every existing session cookie.
LIFTOSAUR_COOKIE_SECRET=change-me-cookie-secret
LIFTOSAUR_CRYPTO_KEY=change-me-crypto-key
# Guards the admin/dashboard and public API endpoints.
LIFTOSAUR_API_KEY=change-me-api-key

# ---------------------------------------------------------------- object storage (MinIO)

# MinIO root credentials. The server and the bootstrap job sign S3 requests with them.
# AWS_SECRET_ACCESS_KEY must be at least 8 characters or MinIO refuses to start.
# DynamoDB Local validates the access key's shape (an AWS-style 16-128 character
# alphanumeric id) even though it accepts any value - keep this key AWS-shaped.
AWS_ACCESS_KEY_ID=LIFTOSAURACCESSKEY01
AWS_SECRET_ACCESS_KEY=change-me-minio-secret
# Only used to build request signatures; DynamoDB Local and MinIO accept any region.
AWS_REGION=us-west-2

# Shared secret between MinIO's bucket-notification webhook and the server's
# /selfhosted/minio-events endpoint (uploaded images are resized there). Must be a single
# word with no spaces - MinIO turns it into `Authorization: Bearer <token>`. Leave empty
# to accept unauthenticated webhook calls (they are only reachable inside the compose network).
LIFTOSAUR_WEBHOOK_TOKEN=change-me-webhook-token

# ---------------------------------------------------------------- email

# Defaults target the bundled mailpit container, which catches every message instead of
# delivering it - open it at http://localhost:8025. For real email, point these at your
# SMTP relay and remove the mailpit service from docker-compose.yml.
# Without SMTP, signup and login still work; email verification and password reset do not.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=liftosaur@localhost

# Host port for mailpit's web UI.
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------- optional features

# AI Liftoscript program generation (https://console.anthropic.com/).
# ANTHROPIC_API_KEY=

# Alternate LLM provider, used by a few AI endpoints.
# OPENAI_API_KEY=

# Server-side error reporting to your own Rollbar project. Off when unset.
# ROLLBAR_SERVER_TOKEN=

# Build identifier shown in debug output; defaults to "selfhosted".
# COMMIT_HASH=
