# Liftosaur self-hosted web tier: builds the webpack bundle with the deployment's public
# URLs baked in, then serves dist/ through nginx.
#
# Build context is the repository root:
#   docker build -f selfhosted/docker/Dockerfile.web \
#     --build-arg LIFTOSAUR_HOST=https://lift.example.com \
#     --build-arg LIFTOSAUR_API_HOST=https://lift.example.com \
#     --build-arg LIFTOSAUR_STREAMING_API_HOST=https://lift.example.com .

# Node 22 matches .nvmrc (lts/jod) and the CodeBuild runtime the production web bundle is built with.
FROM node:22-bookworm AS build

ARG LIFTOSAUR_HOST
ARG LIFTOSAUR_API_HOST
ARG LIFTOSAUR_STREAMING_API_HOST
ARG LIFTOSAUR_SELF_HOSTED=true
ARG COMMIT_HASH=selfhosted

ENV LIFTOSAUR_HOST=${LIFTOSAUR_HOST} \
    LIFTOSAUR_API_HOST=${LIFTOSAUR_API_HOST} \
    LIFTOSAUR_STREAMING_API_HOST=${LIFTOSAUR_STREAMING_API_HOST} \
    LIFTOSAUR_SELF_HOSTED=${LIFTOSAUR_SELF_HOSTED} \
    NODE_ENV=development \
    NODE_OPTIONS=--max-old-space-size=4096

# webpack.config.js falls back to this when `git rev-parse` is unavailable, which it is
# here since .dockerignore keeps .git out of the build context.
ENV CODEBUILD_RESOLVED_SOURCE_VERSION=${COMMIT_HASH}

WORKDIR /src

COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

COPY . .

# `npm run build` is build:prepare + uploadsourcemaps.sh (Rollbar); self-hosted builds want
# only the former. build:prepare runs every generator the webpack entrypoints depend on and
# ends with `NODE_ENV=production webpack`.
RUN npm run build:prepare

FROM nginx:stable-alpine

COPY --from=build /src/dist /usr/share/nginx/html
COPY selfhosted/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# A purely static asset, so the web container stays healthy independently of the API server.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/manifest.webmanifest || exit 1
